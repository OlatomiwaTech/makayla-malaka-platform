NODE_ENV=development
PORT=5000

FRONTEND_URL=http://localhost:3000
# Set FRONTEND_URL to the production frontend's HTTPS origin when NODE_ENV=production.

DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/makayla_platform"
# For Neon, use the pooled endpoint in DATABASE_URL for app traffic.
# Add DIRECT_URL with Neon's direct (non-pooler) endpoint for Prisma migrations.
# DIRECT_URL="postgresql://user:password@host.region.aws.neon.tech/dbname?sslmode=require"
# Generate a private, random key for creating the one-time owner account.
# ADMIN_SETUP_KEY="replace-with-a-random-secret-at-least-32-characters-long"
# Required for video analysis and to verify videos belong to the official channel.
# YOUTUBE_API_KEY="your-server-side-youtube-data-api-v3-key"
# The public handle resolves automatically; set an ID override only if needed.
# YOUTUBE_CHANNEL_HANDLE="@MakaylaSuperstar"
# YOUTUBE_CHANNEL_ID="UCxxxxxxxxxxxxxxxxxxxxxx"
# Admin password reset email (create a Resend API key and verify the sender domain).
# RESEND_API_KEY="re_xxxxxxxxx"
# RESEND_FROM_EMAIL="Makayla Malaka Admin <no-reply@your-verified-domain.com>"
JWT_SECRET="your-jwt-secret"
